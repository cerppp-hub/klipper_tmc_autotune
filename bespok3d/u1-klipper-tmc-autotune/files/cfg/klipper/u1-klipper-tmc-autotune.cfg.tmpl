#
# Generated by Bespok3d from per-printer motor constants. The U1 uses
# sensorless homing on X, Y, and Z, so all three axes stay in performance
# (SpreadCycle) mode and retain the stock firmware's homing thresholds.

[motor_constants snapmaker-u1-xy]
resistance: $U1_XY_RESISTANCE
inductance: $U1_XY_INDUCTANCE
holding_torque: $U1_XY_HOLDING_TORQUE
max_current: $U1_XY_MAX_CURRENT
steps_per_revolution: $U1_XY_STEPS_PER_REVOLUTION

[motor_constants snapmaker-u1-z]
resistance: $U1_Z_RESISTANCE
inductance: $U1_Z_INDUCTANCE
holding_torque: $U1_Z_HOLDING_TORQUE
max_current: $U1_Z_MAX_CURRENT
steps_per_revolution: $U1_Z_STEPS_PER_REVOLUTION

[autotune_tmc stepper_x]
motor: snapmaker-u1-xy
tuning_goal: performance
sgt: 1
sg4_thrs: 0

[autotune_tmc stepper_y]
motor: snapmaker-u1-xy
tuning_goal: performance
sgt: 1
sg4_thrs: 0

[autotune_tmc stepper_z]
motor: snapmaker-u1-z
tuning_goal: performance
sg4_thrs: 110
