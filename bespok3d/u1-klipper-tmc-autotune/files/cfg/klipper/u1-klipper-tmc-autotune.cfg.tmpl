# TMC Autotune for Snapmaker U1
# Copyright (C) 2026 Snapmaker U1 adaptation contributors
# SPDX-License-Identifier: GPL-3.0-only
#
# Generated by Bespok3d for BJ42D29-Y2V01 motors on the TMC2240 X/Y axes and a
# BJ42D22-130 motor on the TMC2209 Z axis. The U1 uses sensorless
# homing on all three axes, so they stay in performance (SpreadCycle) mode and
# retain the stock firmware's homing thresholds.

[motor_constants keli-bj42d29-y2v01]
resistance: 2.2
inductance: 0.0045
holding_torque: 0.60
max_current: 1.5
steps_per_revolution: 200

[motor_constants keli-bj42d22-130]
resistance: $U1_Z_RESISTANCE
inductance: $U1_Z_INDUCTANCE
holding_torque: $U1_Z_HOLDING_TORQUE
max_current: $U1_Z_MAX_CURRENT
steps_per_revolution: 200

[autotune_tmc stepper_x]
motor: keli-bj42d29-y2v01
tuning_goal: performance
sgt: 1
sg4_thrs: 0

[autotune_tmc stepper_y]
motor: keli-bj42d29-y2v01
tuning_goal: performance
sgt: 1
sg4_thrs: 0

[autotune_tmc stepper_z]
motor: keli-bj42d22-130
tuning_goal: performance
sg4_thrs: 110
