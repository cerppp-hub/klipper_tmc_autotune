#
# Generated by Bespok3d for LDO-42STH48-2504MACF motors on the U1's TMC2240
# X/Y axes. Z and all four removable toolhead extruders remain stock.
# The auto goal resolves to performance/SpreadCycle on X/Y. The stock SGT
# sensorless-homing path and threshold are retained.

[autotune_tmc stepper_x]
motor: ldo-42sth48-2504macf
tuning_goal: auto
small_hysteresis: True
sgt: 1
sg4_thrs: 0

[autotune_tmc stepper_y]
motor: ldo-42sth48-2504macf
tuning_goal: auto
small_hysteresis: True
sgt: 1
sg4_thrs: 0
